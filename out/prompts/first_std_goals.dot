digraph G {
rankdir=LR; fontname="Helvetica"; labelloc=t;
label="goal hypergraph and alignment"; node [fontname="Helvetica", fontsize=10];
g0 [shape=box, style="rounded,filled", fillcolor="#a9c9ee", label="g0: confirm my eligibility for the\nlong-stay residence permit in\nMorocco\n[new]"];
g1 [shape=box, style="rounded,filled", fillcolor="#a9c9ee", label="g1: prepare the documentation file\nfor the long-stay residence\npermit in Morocco\n[new]"];
g2 [shape=box, style="rounded,filled", fillcolor="#a9c9ee", label="g2: schedule an appointment for\nthe long-stay residence permit\nin Morocco\n[new]"];
g3 [shape=box, style="rounded,filled", fillcolor="#a9c9ee", label="g3: submit my long-stay residence\npermit file in Morocco\n[new]"];
e0 [shape=diamond, label="+", width=0.3, height=0.3];
g0 -> e0;
g1 -> e0;
e0 -> g2;
g2 -> g3;
}