digraph G {
rankdir=LR; fontname="Helvetica"; labelloc=t;
label="goal hypergraph and alignment"; node [fontname="Helvetica", fontsize=10];
g0 [shape=box, style="rounded,filled", fillcolor="#b7e1b0", label="g0: prepare the documentation file\nfor the long-stay residence\npermit in Morocco\nmatched c17:g1 (m=1.00)\n[reuse]"];
g1 [shape=box, style="rounded,filled", fillcolor="#b7e1b0", label="g1: reserve my appointment for the\nlong-stay residence permit in\nMorocco and clear the charge\nmatched c17:g2 (m=0.93)\n[reuse]"];
g2 [shape=box, style="rounded,filled", fillcolor="#b7e1b0", label="g2: hand in my long-stay residence\npermit application in Morocco\nand make sure of by <CHANNEL>\nmatched c17:g3 (m=0.98)\n[reuse]"];
g0 -> g1;
g1 -> g2;
}