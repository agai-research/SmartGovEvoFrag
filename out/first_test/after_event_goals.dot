digraph G {
rankdir=LR; fontname="Helvetica"; labelloc=t;
label="goal hypergraph and alignment"; node [fontname="Helvetica", fontsize=10];
g0 [shape=box, style="rounded,filled", fillcolor="#b7e1b0", label="g0: confirm my eligibility for the\nlong-stay residence permit in\nMorocco\nmatched uh1.2:g0 (m=1.00)\n[reuse]"];
g1 [shape=box, style="rounded,filled", fillcolor="#a9c9ee", label="g1: prepare the documentation file\nfor the long-stay residence\npermit in Morocco\nmatched uh1.2:g1 (m=0.97)\n[new]"];
g2 [shape=box, style="rounded,filled", fillcolor="#b7e1b0", label="g2: schedule an appointment for\nthe long-stay residence permit\nin Morocco\nmatched uh1.2:g2 (m=1.00)\n[reuse]"];
g3 [shape=box, style="rounded,filled", fillcolor="#b7e1b0", label="g3: submit my long-stay residence\npermit file in Morocco\nmatched uh1.2:g3 (m=1.00)\n[reuse]"];
e0 [shape=diamond, label="+", width=0.3, height=0.3];
g0 -> e0;
g1 -> e0;
e0 -> g2;
g2 -> g3;
}