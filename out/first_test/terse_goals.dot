label="goal hypergraph and alignment"; node [fontname="Helvetica", fontsize=10];
g0 [shape=box, style="rounded,filled", fillcolor="#b7e1b0", label="g0: long-stay residence permit\nMorocco: verify eligibility\nmatched uh1.2:g0 (m=0.90)\n[reuse]"];
